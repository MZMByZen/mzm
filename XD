            function TabMt:CreateSlider(title, min, max, default, suffix, callback)
                local decimals = 2
                if min % 1 == 0 and max % 1 == 0 and default % 1 == 0 then
                    decimals = 0
                end
                local value = math.clamp(default, min, max)
                suffix = suffix or ""
                callback = callback or function() end

                local slider = create("TextButton", {
                    Name = "Slider",
                    Size = UDim2.new(1, 0, 0, 44),
                    BackgroundColor3 = Theme.Element,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    Text = "",
                    LayoutOrder = #tab._elements + 1,
                    Parent = page,
                }, {
                    create("UICorner", { CornerRadius = Theme.Radius }),
                    create("TextLabel", {
                        Name = "Label",
                        Size = UDim2.new(1, -12, 0, 20),
                        Position = UDim2.fromOffset(12, 4),
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = title,
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Left,
                    }),
                    create("TextLabel", {
                        Name = "Value",
                        Size = UDim2.new(1, -12, 0, 16),
                        Position = UDim2.new(1, -12, 0, 4),
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = tostring(value) .. suffix,
                        TextColor3 = Theme.TextDark,
                        TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Right,
                    }),
                    create("Frame", {
                        Name = "Track",
                        Size = UDim2.new(1, -24, 0, 4),
                        Position = UDim2.new(0, 12, 0, 30),
                        BackgroundColor3 = Theme.ToggleDisabled,
                        BorderSizePixel = 0,
                    }, {
                        create("UICorner", { CornerRadius = UDim.new(1, 0) }),
                        create("Frame", {
                            Name = "Fill",
                            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                            BackgroundColor3 = Theme.Accent,
                            BorderSizePixel = 0,
                        }, {
                            create("UICorner", { CornerRadius = UDim.new(1, 0) }),
                            create("Frame", {
                                Name = "Knob",
                                Size = UDim2.fromOffset(12, 12),
                                Position = UDim2.new(1, -6, 0.5, 0),
                                AnchorPoint = Vector2.new(0, 0.5),
                                BackgroundColor3 = Theme.Text,
                                BorderSizePixel = 0,
                            }, {
                                create("UICorner", { CornerRadius = UDim.new(1, 0) }),
                            }),
                        }),
                    }),
                })

                local track = slider:FindFirstChild("Track")
                local fill = track:FindFirstChild("Fill")
                local knob = fill:FindFirstChild("Knob")
                local valueLabel = slider:FindFirstChild("Value")
                local dragging = false
                local element = {}

                local function display()
                    local pct = (value - min) / (max - min)
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    local fmt = "%." .. decimals .. "f"
                    valueLabel.Text = string.format(fmt, value) .. suffix
                end
                local function setFromX(x)
                    local rel = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
                    rel = math.clamp(rel, 0, 1)
                    local prec = math.pow(10, decimals)
                    value = math.floor((min + (max - min) * rel) * prec + 0.5) / prec
                    value = math.clamp(value, min, max)
                    display()
                    callback(value)
                end

                slider.MouseButton1Down:Connect(function()
                    dragging = true
                    setFromX(UserInputService:GetMouseLocation().X)
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        setFromX(input.Position.X)
                    end
                end)
                slider.MouseEnter:Connect(function()
                    TweenService:Create(slider, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ElementHover }):Play()
                end)
                slider.MouseLeave:Connect(function()
                    TweenService:Create(slider, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Element }):Play()
                end)

                function element:Set(v)
                    value = math.clamp(v, min, max)
                    display()
                    callback(value)
                end
                function element:Get() return value end

                element._silent = false
                function element:SetSilent(v)
                    value = math.clamp(v, min, max)
                    element._silent = true
                    display()
                    element._silent = false
                end

                display()
                table.insert(tab._elements, element)
                return element
            end

            function TabMt:CreateDropdown(title, options, default, callback)
                local state = default
                callback = callback or function() end
                local expanded = false

                local dropdown = create("TextButton", {
                    Name = "Dropdown",
                    Size = UDim2.new(1, 0, 0, 44),
                    BackgroundColor3 = Theme.Element,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    Text = "",
                    LayoutOrder = #tab._elements + 1,
                    Parent = page,
                }, {
                    create("UICorner", { CornerRadius = Theme.Radius }),
                    create("TextLabel", {
                        Name = "Label",
                        Size = UDim2.new(1, -12, 0, 16),
                        Position = UDim2.fromOffset(12, 4),
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = title,
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Left,
                    }),
                    create("TextLabel", {
                        Name = "Value",
                        Size = UDim2.new(1, -24, 0, 16),
                        Position = UDim2.fromOffset(12, 20),
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = state or "Selecciona...",
                        TextColor3 = Theme.Accent,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Left,
                    }),
                    create("TextLabel", {
                        Name = "Arrow",
                        Size = UDim2.fromOffset(20, 44),
                        Position = UDim2.new(1, -20, 0, 0),
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        Text = "v",
                        TextColor3 = Theme.TextDark,
                        TextSize = 12,
                    }),
                    create("Frame", {
                        Name = "List",
                        Size = UDim2.new(1, 0, 0, 0),
                        Position = UDim2.fromOffset(0, 44),
                        BackgroundColor3 = Theme.Sidebar,
                        BorderSizePixel = 0,
                        ClipsDescendants = true,
                        Visible = false,
                    }, {
                        create("UICorner", { CornerRadius = Theme.Radius }),
                        create("UIPadding", {
                            PaddingTop = UDim.new(0, 4),
                            PaddingBottom = UDim.new(0, 4),
                        }),
                        create("UIListLayout", {
                            SortOrder = Enum.SortOrder.LayoutOrder,
                            Padding = UDim.new(0, 2),
                        }),
                    }),
                })

                local list = dropdown:FindFirstChild("List")
                local valueLabel = dropdown:FindFirstChild("Value")
                local arrow = dropdown:FindFirstChild("Arrow")
                local element = {}

                local btns = {}
                local function buildOptions()
                    for _, b in ipairs(btns) do b:Destroy() end
                    btns = {}
                    for _, opt in ipairs(options) do
                        local b = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundTransparency = 1,
                            Font = Theme.Font,
                            Text = "  " .. tostring(opt),
                            TextColor3 = Theme.TextDark,
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Parent = list,
                        })
                        b.MouseButton1Click:Connect(function()
                            state = opt
                            valueLabel.Text = tostring(opt)
                            callback(state)
                            element:Close()
                        end)
                        table.insert(btns, b)
                    end
                end

                function element:Open()
                    expanded = true
                    list.Visible = true
                    arrow.Text = "^"
                    local th = #options * 24 + 8
                    TweenService:Create(dropdown, TweenInfo.new(0.15), {
                        Size = UDim2.new(1, 0, 0, 44 + th),
                    }):Play()
                    TweenService:Create(list, TweenInfo.new(0.15), {
                        Size = UDim2.new(1, 0, 0, th),
                    }):Play()
                end

                function element:Close()
                    expanded = false
                    arrow.Text = "v"
                    TweenService:Create(dropdown, TweenInfo.new(0.15), {
                        Size = UDim2.new(1, 0, 0, 44),
                    }):Play()
                    TweenService:Create(list, TweenInfo.new(0.15), {
                        Size = UDim2.new(1, 0, 0, 0),
                    }):Play()
                    task.delay(0.16, function()
                        if not expanded then list.Visible = false end
                    end)
                end

                dropdown.MouseButton1Click:Connect(function()
                    if expanded then element:Close() else element:Open() end
                end)
                dropdown.MouseEnter:Connect(function()
                    TweenService:Create(dropdown, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ElementHover }):Play()
                end)
                dropdown.MouseLeave:Connect(function()
                    TweenService:Create(dropdown, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Element }):Play()
                end)

                function element:Set(v)
                    state = v
                    valueLabel.Text = tostring(v)
                    callback(state)
                end
                function element:Get() return state end
                function element:Update(newOptions)
                    options = newOptions
                    buildOptions()
                end

                buildOptions()
                table.insert(tab._elements, element)
                return element
            end

            function TabMt:CreateTextBox(title, default, placeholder, callback)
                local element = {}
                callback = callback or function() end

                local container = create("Frame", {
                    Name = "TextBox",
                    Size = UDim2.new(1, 0, 0, 44),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
