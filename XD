-- AutoPrediction basado en ping
-- ============================================================
local autoPredThread = nil
local autoPredRunning = false
local function startAutoPrediction()
    if autoPredRunning then return end
    autoPredRunning = true
    autoPredThread = task.spawn(function()
        while autoPredRunning and getgenv().AutoPrediction do
            task.wait(0.5)
            local ping = 0.1
            pcall(function()
                ping = (LocalPlayer.GetNetworkPing and LocalPlayer:GetNetworkPing()) or 0.1
            end)
            local newPred
            if ping > 0.4 then
                newPred = 0.200 + (ping - 0.4) * 0.25
            else
                newPred = 0.150 + (ping - 0.1) * 0.5
            end
            newPred = math.clamp(newPred, 0.05, 0.5)
            getgenv().Prediction = newPred
            if _G.OnAimKeyChangePredict then _G.OnAimKeyChangePredict(newPred) end
        end
        autoPredRunning = false
    end)
end
local function stopAutoPrediction()
    autoPredRunning = false
end
if getgenv().AutoPrediction then startAutoPrediction() end

-- ============================================================
-- Hook __index (nÃºcleo silent aim)
-- ============================================================
local hookInstalled = false
local function installHook()
    if hookInstalled or not hookmetamethod then return end
    hookInstalled = true

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, Index)
        local original = oldIndex(self, Index)
        if self ~= Mouse then return original end
        if Index ~= "Hit" and Index ~= "hit" and Index ~= "Target" and Index ~= "target" then
            return original
        end
        local lookupHit = (Index == "Hit" or Index == "hit")
        local lookupTarget = (Index == "Target" or Index == "target")
        if not SilentAim then
            return original
        end

        local Character = LocalPlayer.Character
        if not Character or not Character:FindFirstChild("Head") then
            return original
        end

        local Distance = math.huge
        local Target = nil
        local fovRadius = FOV_CIRCLE and FOV_CIRCLE.Radius or getgenv().FOV

        for _, v in ipairs(Players:GetPlayers()) do
            if v ~= LocalPlayer
                and not table.find(getgenv().DontShootThesePeople, v.Name)
                and v.Character
                and v.Character:FindFirstChild("HumanoidRootPart")
                and v.Character:FindFirstChild("Humanoid")
                and v.Character.Humanoid.Health > 0 then

                local Enemy = v.Character
                local part = Enemy:FindFirstChild(CurrentHitPart) or Enemy:FindFirstChild("HumanoidRootPart")
                if part then
                    local CastingFrom = CFrame.new(Camera.CFrame.Position, part.CFrame.Position) * CFrame.new(0, 0, -4)
                    local RayCast = Ray.new(CastingFrom.Position, CastingFrom.LookVector * 9000)
                    local _, ToSpace = workspace:FindPartOnRayWithIgnoreList(RayCast, {
                        Character:FindFirstChild("Head"),
                    })
                    local RootWorld = (part.CFrame.Position - ToSpace).Magnitude

                    if RootWorld < 4 then
                        local Pos, Visible = Camera:WorldToScreenPoint(part.Position)
                        if Visible and Pos.Z > 0 then
                            local Real_Magnitude = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(Pos.X, Pos.Y)).Magnitude
                            if Real_Magnitude < Distance and Real_Magnitude < fovRadius then
                                Distance = Real_Magnitude
                                Target = Enemy
                            end
                        end
                    end
                end
            end
        end

        if Target
            and Target:FindFirstChild(CurrentHitPart)
            and Target:FindFirstChild("Humanoid")
            and Target.Humanoid.Health > 0 then
            local Madox = Target[CurrentHitPart]
            local gravityCompensation = Vector3.new(0, (CurrentHitPart == "Head") and 0 or -workspace.Gravity * 0.05 * getgenv().Prediction, 0)
            local Formulate = Madox.CFrame.Position + (Madox.AssemblyLinearVelocity * getgenv().Prediction) + gravityCompensation
            if lookupHit then
                return CFrame.new(Formulate)
            elseif lookupTarget then
                return Target
            end
        end
        return original
    end)
end
installHook()

