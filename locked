-- ⚽ BALL SYSTEM + HUD COMPLETO (un solo LocalScript -> StarterPlayerScripts)
-- Incluye: detección de pelota (spawn/respawn/toques/eliminación),
--          Auto-M2 anti-robo y HUD burbuja transparente con pestañas.

-- [1] SERVICIOS
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- [2] CONFIG (ajustable desde el HUD en vivo)
local Config = {
	autoM2        = true,   -- dispara el remoto de patada/robo
	detectTouches = true,   -- registra cuando la pelota toca a un jugador
	remoteName    = "kick", -- nombre del remoto del M2 en el juego
	cooldown      = 0.3,    -- segundos entre M2
	touchDistance = 4,      -- distancia para detectar rivales (studs)
	trackPosition = false,  -- imprime la posición cada 0.5s
	selfNear      = true,   -- solo reacciona si estoy cerca de la pelota
}

-- [3] PALETA MORADA OSCURA
local COLORS = {
	background = Color3.fromRGB(30, 10, 52),
	surface    = Color3.fromRGB(48, 18, 82),
	border     = Color3.fromRGB(20, 6, 38),
	accent     = Color3.fromRGB(126, 45, 200),
	hover      = Color3.fromRGB(150, 60, 235),
	text       = Color3.fromRGB(235, 230, 245),
	textDim    = Color3.fromRGB(175, 165, 200),
	green      = Color3.fromRGB(110, 255, 170),
	red        = Color3.fromRGB(255, 110, 110),
}

-- [4] UTILIDADES UI
local function ui(cls, props)
	local i = Instance.new(cls)
	local parent = props.Parent
	for k, v in pairs(props) do
		if k ~= "Parent" then i[k] = v end
	end
	if parent then i.Parent = parent end
	return i
end
local function rounde(inst, radius)
	local c = Instance.new("UICorner", inst)
	c.CornerRadius = radius or UDim.new(1, 0)
end
local function stroke(inst, color, thickness)
	local s = Instance.new("UIStroke", inst)
	s.Color = color or COLORS.border
	s.Thickness = thickness or 2
end

-- [5] COMPONENTES (Toggle / Slider / TextBox)
local function makeToggle(parent, text, get, set)
	local row = ui("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 })
	ui("TextLabel", { Parent = row, BackgroundTransparency = 1, Text = text, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = COLORS.text, Size = UDim2.new(0, 290, 1, 0), Position = UDim2.new(0, 10, 0, 0) })
	local knob = ui("TextButton", { Parent = row, BackgroundColor3 = COLORS.surface, Text = "", AutoButtonColor = false, Size = UDim2.new(0, 52, 0, 22), Position = UDim2.new(1, -62, -4, 0) })
	local dot = ui("Frame", { Parent = knob, BackgroundColor3 = COLORS.textDim, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 3, 3, 0) })
	rounde(knob); rounde(dot); stroke(knob, COLORS.border, 1)
	local function refresh()
		local on = get()
		knob.BackgroundColor3 = on and COLORS.accent or COLORS.surface
		dot.Position = on and UDim2.new(1, -19, 3, 0) or UDim2.new(0, 3, 3, 0)
		dot.BackgroundColor3 = on and COLORS.hover or COLORS.textDim
	end
	knob.MouseButton1Click:Connect(function() set(not get()); refresh() end)
	refresh()
end

local function makeSlider(parent, text, min, max, fmt, get, set)
	local row = ui("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 })
	ui("TextLabel", { Parent = row, BackgroundTransparency = 1, Text = text, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = COLORS.text, Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(0, 10, 0, 0) })
	local val = ui("TextLabel", { Parent = row, BackgroundTransparency = 1, Text = "", TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamSemibold, TextSize = 13, TextColor3 = COLORS.accent, Size = UDim2.new(0, 80, 1, 0), Position = UDim2.new(1, -90, 0, 0) })
	local bar = ui("Frame", { Parent = row, BackgroundColor3 = COLORS.surface, BackgroundTransparency = 0.1, Size = UDim2.new(1, -320, 0, 6), Position = UDim2.new(0, 215, 0, 14) })
	local fill = ui("Frame", { Parent = bar, BackgroundColor3 = COLORS.accent, Size = UDim2.new(0, 0, 1, 0) })
	local knob = ui("Frame", { Parent = bar, AnchorPoint = UDim2.new(0.5, 0.5), BackgroundColor3 = COLORS.hover, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 0, 0.5, 0), ZIndex = 2 })
	rounde(bar, UDim.new(1, 0)); rounde(fill, UDim.new(1, 0)); rounde(knob)
	stroke(bar, COLORS.border, 1); stroke(knob, COLORS.accent, 2)
	local function refresh()
		local t = math.clamp((get() - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(t, 0, 1, 0)
		knob.Position = UDim2.new(t, 0, 0.5, 0)
		val.Text = fmt(get())
	end
	local function pointToMouse()
		local rel = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		set(min + (max - min) * rel)
		refresh()
	end
	local dragging = false
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; pointToMouse() end
	end)
	bar.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then pointToMouse() end
	end)
	bar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	refresh()
end

local function makeTextBox(parent, text, get, set)
	local row = ui("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 })
	ui("TextLabel", { Parent = row, BackgroundTransparency = 1, Text = text, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = COLORS.text, Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(0, 10, 0, 0) })
	local box = ui("TextBox", { Parent = row, BackgroundColor3 = COLORS.surface, BackgroundTransparency = 0.1, Text = get(), PlaceholderColor3 = COLORS.textDim, TextColor3 = COLORS.text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(0, 170, 0, 24), Position = UDim2.new(1, -180, 0, 5) })
	rounde(box); stroke(box, COLORS.border, 1)
	box.FocusLost:Connect(function(enterPressed) if enterPressed then set(box.Text) end end)
end

