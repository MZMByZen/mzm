local remoteStatus = ui("TextLabel", { Parent = tab3, BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.text, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.new(0, 10, 0, 40) })
local touchStatus = ui("TextLabel", { Parent = tab3, BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.text, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.new(0, 10, 0, 70) })
ui("TextLabel", { Parent = tab3, BackgroundTransparency = 1, TextWrapped = true, Text = "Ajustes en vivo desde el HUD. Si el M2 no funciona, cambia el nombre del remoto en la pestaña ANTI-ROBO.", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = COLORS.textDim, Size = UDim2.new(1, -20, 0, 70), Position = UDim2.new(0, 10, 0, 110) })

local function activateTab(i)
	for k, btn in ipairs(tabButtons) do
		btn.BackgroundColor3 = k == i and COLORS.accent or COLORS.surface
		btn.TextColor3 = k == i and Color3.new(1, 1, 1) or COLORS.textDim
	end
	for k, ctn in ipairs(tabContents) do
		ctn.Visible = (k == i)
	end
end
for i_ in ipairs(tabButtons) do
	tabButtons[i_].MouseButton1Click:Connect(function() activateTab(i_) end)
end
activateTab(1)

-- [7] DETECCIÓN DE LA PELOTA
local Ball = nil
local ballFolder = Workspace:WaitForChild("BallFolderServer", 5)

local function waitForBall()
	if not ballFolder then return nil end
	Ball = ballFolder:WaitForChild("ballEntity", 5)
	if Ball then
		print("[DETECCION] Pelota encontrada:", Ball:GetFullName())
		setupBall()
	end
	return Ball
end

-- Toques de la pelota (cambia el estado en la pestaña INFO)
local lastTouchPlayer = "Ninguno"
local lastTouchTime = os.clock()
local function onBallTouched(hit)
	if not Config.detectTouches then return end
	if not hit or not hit.Parent then return end
	if hit.Parent:FindFirstChildOfClass("Humanoid") then
		lastTouchPlayer = hit.Parent.Name
		lastTouchTime = os.clock()
		print("[DETECCION] La pelota tocó a:", hit.Parent.Name)
	end
end

local function setupBall()
	if not Ball then return end
	local prim = Ball:IsA("Model") and Ball.PrimaryPart or (Ball:IsA("BasePart") and Ball or nil)
	if prim then
		prim.Touched:Connect(onBallTouched)
	end
	-- detecta eliminación o movimiento
	Ball.AncestryChanged:Connect(function()
		if not Ball.Parent or Ball.Parent == nil then
			print("[DETECCION] La pelota fue eliminada o movida")
		end
	end)
end

Ball = waitForBall()

-- [8] AUTO-M2 (remoto del juego)
local function findKickRemote()
	for _, inst in ipairs(game:GetDescendants()) do
		local n = string.lower(inst.Name)
		if (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")) and n:find(string.lower(Config.remoteName)) then
			return inst
		end
	end
	return nil
end

local kickRemote = findKickRemote()
task.spawn(function() -- re-busca si cambias el nombre o aún no carga
	while true do
		if Config.remoteName and (not kickRemote) then
			kickRemote = findKickRemote()
		end
		task.wait(3)
	end
end)

local function getBallPosition()
	if not Ball then return nil end
	if Ball:IsA("BasePart") then
		return Ball.Position
	elseif Ball:IsA("Model") and Ball.PrimaryPart then
		return Ball.PrimaryPart.Position
	end
	return nil
end

local function doM2()
	if not kickRemote then return end
	if kickRemote:IsA("RemoteEvent") then
		kickRemote:FireServer()
	elseif kickRemote:IsA("RemoteFunction") then
		task.spawn(function() pcall(function() kickRemote:InvokeServer() end) end)
	end
end

local function otherPlayerOnBall()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local ballPos = getBallPosition()
	if not root or not ballPos then return false end
	if Config.selfNear and (root.Position - ballPos).Magnitude > Config.touchDistance * 1.5 then
		return false
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local otherRoot = player.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot and (otherRoot.Position - ballPos).Magnitude <= Config.touchDistance then
				return true
			end
		end
	end
	return false
end

-- [9] BUCLE PRINCIPAL (Auto-M2)
task.spawn(function()
	while true do
		task.wait(Config.cooldown)
		if Config.autoM2 and otherPlayerOnBall() then
			doM2()
		end
	end
end)

-- [10] RASTREO DE POSICIÓN (opcional)
task.spawn(function()
	while true do
		task.wait(0.5)
		if Config.trackPosition then
			local pos = getBallPosition()
			if pos then print("[DETECCION] Posición:", pos) end
		end
	end
end)

-- [11] RE-DETECCIÓN (re-spawn o destrucción)
if ballFolder then
	ballFolder.ChildAdded:Connect(function(child)
		if child.Name == "ballEntity" then
			waitForBall()
			print("[DETECCION] Pelota re-spawneada")
		end
	end)
end
task.spawn(function() -- respaldo: si la pelota desaparece, vuelve a buscarla
	while true do
		task.wait(2)
		if not Ball or not Ball.Parent then
			Ball = waitForBall()
		end
	end
end)

-- [12] ESTADO EN LA PESTAÑA INFO
task.spawn(function()
	while true do
		local hasBall = Ball ~= nil and Ball.Parent ~= nil
		ballStatus.Text = hasBall and "● Pelota: CONECTADA" or "● Pelota: BUSCANDO..."
		ballStatus.TextColor3 = hasBall and COLORS.green or COLORS.red
		remoteStatus.Text = kickRemote and ("● Remoto M2 ('" .. Config.remoteName .. "'): ENCONTRADO") or ("● Remoto M2 ('" .. Config.remoteName .. "'): NO ENCONTRADO")
		remoteStatus.TextColor3 = kickRemote and COLORS.green or COLORS.red
		local secs = math.max(0, math.floor(os.clock() - lastTouchTime))
		touchStatus.Text = "● Último toque: " .. lastTouchPlayer .. " (hace " .. secs .. "s)"
		touchStatus.TextColor3 = (lastTouchPlayer ~= "Ninguno") and COLORS.green or COLORS.textDim
		task.wait(1)
	end
end)
